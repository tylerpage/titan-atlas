APP_NAME=Atlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# For ngrok: APP_URL=https://your-subdomain.ngrok-free.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
# Use database only if you need shared sessions across multiple app servers.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# ngrok / HTTPS tunnels:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=titan
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Sync job chunking for hosted workers (Laravel Cloud ~60s limit)
# TITAN_SYNC_PAGES_PER_JOB=2
# TITAN_SYNC_MAX_SECONDS_PER_JOB=45
# TITAN_SYNC_JOB_TIMEOUT=55

CACHE_STORE=file
# Use redis/database in production. file is faster for local/ngrok dev.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# On Laravel Cloud with R2, set MAIL_MAILER=ses and use SES_* (not AWS_*).
# AWS_* is injected for object storage (region may be "auto"); SES needs a real AWS region.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# ngrok + Vite dev only: tunnel port 5173 separately, then set:
# VITE_DEV_SERVER_URL=https://your-vite-tunnel.ngrok-free.app
# VITE_HMR_HOST=your-vite-tunnel.ngrok-free.app
# Otherwise run `npm run build` and remove public/hot (single tunnel).

OPENAI_API_KEY=
TITAN_AI_PROVIDER=openai

# Google OAuth (Search Console, GA4, Ads connectors)
# Enable Search Console API + Google Analytics Data API + Google Analytics Admin API + Google Ads API in GCP.
# Redirect URI: {APP_URL}/admin/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Developer token from Google Ads API Center (required for Google Ads connector)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads API version (v18 is sunset; use v21+)
# TITAN_GOOGLE_ADS_API_VERSION=v21
# StackAdapt GraphQL connector (optional overrides)
# TITAN_STACKADAPT_GRAPHQL_ENDPOINT=https://api.stackadapt.com/graphql
# TITAN_STACKADAPT_BACKFILL_MONTHS=16
# TITAN_STACKADAPT_INCREMENTAL_DAYS=5
# TITAN_STACKADAPT_DATA_LAG_DAYS=1
# TITAN_STACKADAPT_USE_REST_FALLBACK=false
# TITAN_DASHBOARD_CONNECTOR_CACHE_ENABLED=true
# TITAN_DASHBOARD_CONNECTOR_CACHE_TTL_SECONDS=90
# Dispatch one ingestion job per connector stream so managed queues can scale workers (default: true)
# TITAN_SYNC_STREAM_FAN_OUT_ENABLED=true
# Backfills pull recent dates first; transform runs during sync for faster dashboards
# TITAN_SYNC_BACKFILL_NEWEST_FIRST=true
# TITAN_SYNC_TRANSFORM_DURING_SYNC=true
# Skip mid-sync transforms during backfill to reduce queue load (finalize still runs at sync end)
# TITAN_SYNC_TRANSFORM_DURING_BACKFILL=false
# Transform queue chunking for Laravel Cloud worker limits (default: 750 payloads x 3 chunks, 45s)
# TITAN_TRANSFORM_PAYLOADS_PER_CHUNK=750
# TITAN_TRANSFORM_CHUNKS_PER_JOB=3
# TITAN_TRANSFORM_MAX_SECONDS_PER_JOB=45
# TITAN_TRANSFORM_JOB_TIMEOUT=55
# Production admin bootstrap: php artisan titan:create-admin (see README)
# TITAN_ADMIN_EMAIL=you@example.com
# TITAN_ADMIN_NAME=Platform Admin
# TITAN_ADMIN_PASSWORD=

TITAN_AI_MODEL=gpt-4o-mini
TITAN_AI_MAX_STEPS=8
TITAN_AI_CLIENT_MAX_STEPS=4
TITAN_AI_MAX_HISTORY_MESSAGES=12
TITAN_AI_PREVIEW_CACHE_TTL=60
TITAN_AI_FAST_PATH_ENABLED=true
TITAN_AI_RESPONSE_TIMEOUT=120
TITAN_CONNECTOR_BUILDER_MODEL=gpt-4o-mini
TITAN_CONNECTOR_BUILDER_MAX_STEPS=15
TITAN_CONNECTOR_BUILDER_HTTP_TIMEOUT=30
TITAN_AI_ASSISTANT_NAME=TitanAI
